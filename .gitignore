__pycache__/
*.pyc
.DS_Store
node_modules/
*.pdf
page-*.jpg
.ipynb_checkpoints/
.venv/

# Terraform (cloud/infra) -- state and local caches, never committed
# (state can contain sensitive values, and is specific to your own AWS
# account's deployment, not something to share via git).
cloud/infra/.terraform/
cloud/infra/.terraform.lock.hcl
cloud/infra/*.tfstate
cloud/infra/*.tfstate.*
cloud/infra/*.tfplan
cloud/infra/crash.log

# The remote-state bootstrap (cloud/infra/bootstrap/) is its own tiny root
# module with its own local state -- same reasoning as above.
cloud/infra/bootstrap/.terraform/
cloud/infra/bootstrap/.terraform.lock.hcl
cloud/infra/bootstrap/*.tfstate
cloud/infra/bootstrap/*.tfstate.*
cloud/infra/bootstrap/*.tfplan
cloud/infra/bootstrap/crash.log

# Generated at `terraform apply` time from config.js.tpl -- never hand-edit
# or commit a real one (see cloud/frontend/config.js.tpl).
cloud/frontend/config.js

# v2
results/raw/*
!results/raw/README.md
worlds/*.parquet
worlds/*/
.dvc/cache
